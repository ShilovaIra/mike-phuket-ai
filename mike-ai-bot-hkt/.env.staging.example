# Copy to .env on the staging server:
#   cp .env.staging.example .env
#
# Use a SEPARATE Telegram bot for staging (create via @BotFather).
# Never reuse production tokens on staging.
#
# Keep POSTGRES_* and DATABASE_URL in sync. Special characters in
# POSTGRES_PASSWORD are OK — Compose sets POSTGRES_HOST=db and the app
# builds a safely encoded URL.

TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# Google Cloud key with the Places API (New) enabled. Empty = Mike answers
# without looking up real places, so he may name a place that does not exist.
GOOGLE_PLACES_API_KEY=
# Optional. Empty = skip TGTrack. Do not reuse the production key (different bot).
TGTRACK_API_KEY=
# Comma-separated Telegram user/chat ids (both can use /stats; all get leads).
ADMIN_CHAT_ID=

# Admin web API
ADMIN_JWT_SECRET=
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8000
ADMIN_CORS_ORIGINS=
# Host ports for local health checks. Public access is HTTPS via Caddy, not these.
ADMIN_WEB_PORT=8080
PARTNER_WEB_PORT=8081
TMA_WEB_PORT=8082
ADMIN_PUBLIC_HOST=admin-staging.mikephuketai.com
PARTNER_PUBLIC_HOST=partners-staging.mikephuketai.com
TMA_PUBLIC_HOST=app-staging.mikephuketai.com
# Telegram wrap + Partner Dashboard origin. deploy_staging.sh sets this from
# PARTNER_PUBLIC_HOST when empty or still an http://IP:port value.
PARTNER_OFFER_BASE_URL=https://partners-staging.mikephuketai.com
# Start the Caddy TLS proxy (profile `tls`) with every compose command.
COMPOSE_PROFILES=tls

# DigitalOcean Spaces (S3-compatible) for dynamic assets: partner logos,
# place/cafe/island photos. Use a Limited Access key scoped to the staging
# bucket only — never the production bucket or key.
S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
S3_REGION=sgp1
S3_BUCKET=mike-phuket-staging-spaces
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public read origin (Spaces CDN endpoint or custom domain), no trailing slash.
S3_PUBLIC_BASE_URL=https://cdn-staging.mikephuketai.com

POSTGRES_USER=mike
POSTGRES_PASSWORD=
POSTGRES_DB=mike

DATABASE_URL=postgresql://mike:@db:5432/mike

# Copy to .env on the staging server:
#   cp .env.staging.example .env
#
# Use a SEPARATE Telegram bot for staging (create via @BotFather).
# Never reuse production tokens on staging.

TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
ADMIN_CHAT_ID=

# Postgres credentials (used by docker-compose db service).
POSTGRES_USER=mike
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=mike

# On Docker Compose, DATABASE_URL is overridden for the bot container in
# docker-compose.yml (points at the internal `db` service). Keep this set
# anyway for one-off scripts run via `docker compose run` / host imports.
DATABASE_URL=postgresql://mike:change-me-to-a-long-random-string@db:5432/mike

# For local runs against the compose Postgres from your laptop (published port):
# DATABASE_URL=postgresql://mike:change-me-to-a-long-random-string@localhost:5432/mike

# Copy to .env on the production server:
#   cp .env.production.example .env
#
# Use the PRODUCTION Telegram bot token only.
# Never put staging tokens here.
#
# Keep POSTGRES_* and DATABASE_URL in sync. Special characters in
# POSTGRES_PASSWORD are OK — Compose sets POSTGRES_HOST=db and the app
# builds a safely encoded URL.

TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
ADMIN_CHAT_ID=

POSTGRES_USER=mike
POSTGRES_PASSWORD=
POSTGRES_DB=mike

DATABASE_URL=postgresql://mike:@db:5432/mike

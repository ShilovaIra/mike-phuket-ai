# Copy to .env on the production server:
#   cp .env.production.example .env
#
# Use the PRODUCTION Telegram bot token only.
# Never put staging tokens here.

TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
ADMIN_CHAT_ID=

# Postgres credentials (used by docker-compose db service).
POSTGRES_USER=mike
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=mike

# On Docker Compose, DATABASE_URL is overridden for the bot container in
# docker-compose.yml (points at the internal `db` service). Keep this set
# anyway for one-off scripts run via `docker compose run` / host imports.
DATABASE_URL=postgresql://mike:change-me-to-a-long-random-string@db:5432/mike

# If you use managed Postgres instead of the compose db service, set DATABASE_URL
# to that connection string and run only the bot service (see docs/PRODUCTION.md).

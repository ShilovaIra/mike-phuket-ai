# Local / non-Docker runs. For staging/prod Droplets use:
#   .env.staging.example  →  .env
#   .env.production.example  →  .env

TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
ADMIN_CHAT_ID=

# Required by the bot (SessionStore).
DATABASE_URL=postgresql://mike:mike-hkt-ai-bot@localhost:5432/mike

# Optional — used by pytest (falls back to DATABASE_URL if unset).
TEST_DATABASE_URL=postgresql://mike:mike-hkt-ai-bot@localhost:5432/mike_test

# Used by docker-compose.yml for the db service (and to build DATABASE_URL inside the bot container).
POSTGRES_USER=mike
POSTGRES_PASSWORD=mike-hkt-ai-bot
POSTGRES_DB=mike

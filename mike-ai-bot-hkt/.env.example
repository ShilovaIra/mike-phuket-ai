# Local / non-Docker runs. For staging/prod Droplets use:
#   .env.staging.example  →  .env
#   .env.production.example  →  .env
#
# Keep POSTGRES_* and DATABASE_URL in sync (same user/password/db).
# Passwords with @ : / # % etc. are fine — the app URL-encodes POSTGRES_*.

TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# Comma-separated Telegram user/chat ids (both can use /stats; all get leads).
ADMIN_CHAT_ID=

# Admin web API (JWT). Use a long random secret in every environment.
ADMIN_JWT_SECRET=
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8000
# Comma-separated browser origins allowed to call the API.
ADMIN_CORS_ORIGINS=http://localhost:5173

POSTGRES_USER=mike
POSTGRES_PASSWORD=
POSTGRES_DB=mike

# Local host. On Docker Compose, POSTGRES_HOST=db is injected; password is
# taken from POSTGRES_PASSWORD (encoded), not from a raw URL override.
DATABASE_URL=postgresql://mike:@localhost:5432/mike
TEST_DATABASE_URL=postgresql://mike:@localhost:5432/mike_test

# Local / non-Docker runs. For staging/prod Droplets use:
#   .env.staging.example  →  .env
#   .env.production.example  →  .env
#
# Keep POSTGRES_* and DATABASE_URL in sync (same user/password/db).
# Passwords with @ : / # % etc. are fine — the app URL-encodes POSTGRES_*.

TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# Google Cloud key with the Places API (New) enabled. Empty = Mike answers
# without looking up real places, so he may name a place that does not exist.
GOOGLE_PLACES_API_KEY=
# Optional. Empty = skip TGTrack (“Откуда Подписчики”).
TGTRACK_API_KEY=
# Comma-separated Telegram user/chat ids (both can use /stats; all get leads).
ADMIN_CHAT_ID=

# Admin web API (JWT). Use a long random secret in every environment.
ADMIN_JWT_SECRET=
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8000
# Local Vite: leave empty and use npm run dev proxy, or set http://localhost:8000
ADMIN_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_WEB_PORT=8080
PARTNER_WEB_PORT=8081

# Public origin Telegram uses for wrapped Partner offer URLs (must reach /r/…).
PARTNER_OFFER_BASE_URL=http://localhost:8081

POSTGRES_USER=mike
POSTGRES_PASSWORD=
POSTGRES_DB=mike

# Local host. On Docker Compose, POSTGRES_HOST=db is injected; password is
# taken from POSTGRES_PASSWORD (encoded), not from a raw URL override.
DATABASE_URL=postgresql://mike:@localhost:5432/mike
TEST_DATABASE_URL=postgresql://mike:@localhost:5432/mike_test
